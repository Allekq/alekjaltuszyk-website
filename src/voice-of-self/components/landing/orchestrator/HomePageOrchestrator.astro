---
import type { NavPillLink } from "../types";
import LandingHeader from "../sections/LandingHeader.astro";
import HeroSection from "../sections/HeroSection.astro";
import WhyItMattersSection from "../sections/WhyItMattersSection.astro";
import PositioningSection from "../sections/PositioningSection.astro";
import HowItWorksSection from "../sections/HowItWorksSection.astro";
import FeatureGridSection from "../sections/FeatureGridSection.astro";
import FaqSection from "../sections/FaqSection.astro";
import DownloadSection from "../sections/DownloadSection.astro";

const navTabs: NavPillLink[] = [
  {
    label: "Main",
    href: "#main",
    sectionId: "main",
  },
  {
    label: "Why it matters",
    href: "#why-it-matters",
    sectionId: "why-it-matters",
  },
  {
    label: "How it works",
    href: "#how-it-works",
    sectionId: "how-it-works",
  },
  {
    label: "FAQ",
    href: "#faq",
    sectionId: "faq",
  },
];
---

<LandingHeader tabs={navTabs} />

<HeroSection />
<WhyItMattersSection />
<PositioningSection />
<HowItWorksSection />
<FeatureGridSection />
<FaqSection />
<DownloadSection />
