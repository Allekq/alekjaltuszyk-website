---
import "../../../voice-of-self/styles/landing.css";
import HomePageOrchestrator from "../../../voice-of-self/components/landing/orchestrator/HomePageOrchestrator.astro";
import { faqEntries } from "../../../voice-of-self/components/landing/sections/faq.data";
import { siteConfig } from "../../../voice-of-self/config/site";
import { toAbsoluteSiteUrl } from "../../../voice-of-self/lib/discovery";
import SiteLayout from "../../../voice-of-self/layouts/SiteLayout.astro";
import SiteFooter from "../../../voice-of-self/components/landing/sections/SiteFooter.astro";

const organizationId = `${siteConfig.origin}#organization`;
const homePageStructuredData = [
  {
    "@context": "https://schema.org",
    /* Dual-typed the way PlanKept's node is: MobileApplication alone is a valid
       subtype, but a consumer keying on SoftwareApplication -- which is what the
       other four apps here declare -- would not match it. */
    "@type": ["SoftwareApplication", "MobileApplication"],
    "@id": `${siteConfig.origin}#app`,
    name: siteConfig.name,
    alternateName: "Closure",
    operatingSystem: "iOS",
    applicationCategory: "LifestyleApplication",
    url: siteConfig.origin,
    image: siteConfig.defaultSocialImageUrl,
    description: siteConfig.aiDiscovery.summary,
    /* The App Store link was reachable only from the markup, so nothing reading
       the graph could tell where the app installs from. */
    downloadUrl: siteConfig.appStoreHref,
    installUrl: siteConfig.appStoreHref,
    publisher: {
      "@id": organizationId,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Alek Jałtuszyk", item: toAbsoluteSiteUrl("/") },
      { "@type": "ListItem", position: 2, name: "Apps", item: toAbsoluteSiteUrl("/apps/") },
      { "@type": "ListItem", position: 3, name: siteConfig.name, item: siteConfig.origin },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqEntries.map((entry) => ({
      "@type": "Question",
      name: entry.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: entry.answer,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: siteConfig.homeTitle,
    url: toAbsoluteSiteUrl(siteConfig.homePath),
    description: siteConfig.defaultDescription,
    about: {
      "@type": "Thing",
      name: siteConfig.name,
      description: siteConfig.aiDiscovery.summary,
    },
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteConfig.origin}#website`,
    },
  },
];
---

<SiteLayout
  title={siteConfig.homeTitle}
  description={siteConfig.defaultDescription}
  structuredData={homePageStructuredData}
>
  <HomePageOrchestrator />
  <SiteFooter />

  <script>
    import "../../../voice-of-self/scripts/landing/init";
  </script>
</SiteLayout>
