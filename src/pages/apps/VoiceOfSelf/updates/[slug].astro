---
import "../../../../voice-of-self/styles/landing.css";
import "../../../../voice-of-self/styles/visibility.css";
import SiteFooter from "../../../../voice-of-self/components/landing/sections/SiteFooter.astro";
import UpdatePostView from "../../../../voice-of-self/components/visibility/UpdatePostView.astro";
import { siteConfig } from "../../../../voice-of-self/config/site";
import {
  getVisibilityUpdatePath,
  visibilityUpdatePosts,
} from "../../../../voice-of-self/config/visibility";
import { toAbsoluteSiteUrl } from "../../../../voice-of-self/lib/discovery";
import SiteLayout from "../../../../voice-of-self/layouts/SiteLayout.astro";

export const getStaticPaths = () =>
  visibilityUpdatePosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));

const { post } = Astro.props;
const postUrl = toAbsoluteSiteUrl(getVisibilityUpdatePath(post.slug));
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.description,
    url: postUrl,
    datePublished: post.publishedDate,
    author: {
      "@type": "Person",
      name: siteConfig.legalName,
    },
    publisher: {
      "@id": `${siteConfig.origin}#organization`,
    },
    about: {
      "@type": "SoftwareApplication",
      name: siteConfig.name,
      applicationCategory: "LifestyleApplication",
      operatingSystem: "iOS",
    },
  },
];
---

<SiteLayout
  title={post.title}
  description={post.description}
  pageType="content"
  structuredData={structuredData}
>
  <UpdatePostView post={post} />
  <SiteFooter />
</SiteLayout>
