---
import "../../../../voice-of-self/styles/landing.css";
import "../../../../voice-of-self/styles/visibility.css";
import SiteFooter from "../../../../voice-of-self/components/landing/sections/SiteFooter.astro";
import AnswerHubView from "../../../../voice-of-self/components/visibility/AnswerHubView.astro";
import {
  getVisibilityAnswerPath,
  visibilityAnswerHub,
  visibilityAnswerPages,
} from "../../../../voice-of-self/config/visibility";
import { siteConfig } from "../../../../voice-of-self/config/site";
import { toAbsoluteSiteUrl } from "../../../../voice-of-self/lib/discovery";
import SiteLayout from "../../../../voice-of-self/layouts/SiteLayout.astro";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: visibilityAnswerHub.title,
    url: toAbsoluteSiteUrl(visibilityAnswerHub.path),
    description: visibilityAnswerHub.description,
    about: {
      "@type": "SoftwareApplication",
      name: siteConfig.name,
      applicationCategory: "LifestyleApplication",
      operatingSystem: "iOS",
    },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: visibilityAnswerPages.map((page, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: toAbsoluteSiteUrl(getVisibilityAnswerPath(page.slug)),
        name: page.question,
      })),
    },
  },
];
---

<SiteLayout
  title={visibilityAnswerHub.title}
  description={visibilityAnswerHub.description}
  pageType="content"
  structuredData={structuredData}
>
  <AnswerHubView />
  <SiteFooter />
</SiteLayout>
