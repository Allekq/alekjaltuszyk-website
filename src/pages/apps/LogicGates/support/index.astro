---
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import SupportGuide from "../../../../components/support/SupportGuide.astro";
import SiteFooter from "../../../../components/landing/sections/SiteFooter.astro";
import { logicGatesConfig } from "../../../../config/site";
---
<SiteLayout title="Support | Logic Gates" description="Email the Logic Gates developer for questions, feedback, circuit issues or privacy requests." pageType="content">
  <SupportGuide config={logicGatesConfig}>
    <details>
      <summary>Recovery and privacy questions</summary>
      <p>If you need to recover work, avoid deleting the app before asking for help. The developer has no remote copy of your circuits. Deleting the app removes local data; older recovery saves may retain deleted projects, and device backups follow your Apple settings. Recovery is not guaranteed.</p>
      <p>The same email handles requests about support correspondence. The developer cannot access or erase circuits stored only on your device.</p>
      <p>Logic Gates is intended for learners aged 13 and older. A parent or guardian should send support requests for a child who cannot give valid consent themselves. Avoid including a child's personal information when an anonymous circuit example is enough.</p>
    </details>
  </SupportGuide>
  <SiteFooter links={logicGatesConfig.footerLinks} showBrand={false} showSocials={false} />
</SiteLayout>
