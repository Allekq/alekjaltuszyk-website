---
import "../../styles/apps.css";
import AppGridSection from "../../components/landing/sections/apps/AppGridSection.astro";
import AppShowcaseSection from "../../components/landing/sections/apps/AppShowcaseSection.astro";
import AppsIntroSection from "../../components/landing/sections/apps/AppsIntroSection.astro";
import SimpleSiteHeader from "../../components/landing/sections/SimpleSiteHeader.astro";
import SiteFooter from "../../components/landing/sections/SiteFooter.astro";
import { siteRoutes } from "../../config/routes";
import { siteConfig } from "../../config/site";
import { appNameList } from "../../lib/appState";
import { toAbsoluteSiteUrl } from "../../lib/discovery";
import SiteLayout from "../../layouts/SiteLayout.astro";

const personId = `${siteConfig.origin}#person`;
const appsPageDescription = `Directory of current products by Alek Jałtuszyk: ${appNameList}.`;
const appsPageStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Apps",
    url: toAbsoluteSiteUrl(siteRoutes.apps.index.path),
    description: appsPageDescription,
    about: { "@id": personId },
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteConfig.origin}#website`,
    },
  },
];
---

<SiteLayout
  title="Apps"
  description={appsPageDescription}
  pageType="landing"
  structuredData={appsPageStructuredData}
>
  <SimpleSiteHeader />
  <AppsIntroSection
    eyebrow="Current products"
    headingLevel="h1"
    body="One at a time as you scroll, or all at once in the grid at the bottom — whichever you came for."
  />
  <AppShowcaseSection gridHref="#grid" />
  <AppGridSection />
  <SiteFooter />
</SiteLayout>
