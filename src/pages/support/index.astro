---
import SiteFooter from "../../components/landing/sections/SiteFooter.astro";
import {
  audioBookChoicesConfig,
  overLitConfig,
  planKeptConfig,
  siteConfig,
  takeMeSomewhereConfig,
} from "../../config/site";
import { siteRoutes } from "../../config/routes";
import { siteConfig as voiceOfSelfConfig } from "../../voice-of-self/config/site";
import SiteLayout from "../../layouts/SiteLayout.astro";

const supportItems = [
  {
    name: "PlanKept",
    description: "Support for plans, reminders, app blocking, Proof Review, Apple Health checks, purchases, and local-first app behavior.",
    href: siteRoutes.apps.planKeptSupport.href,
    email: planKeptConfig.supportEmail,
  },
  {
    name: "Voice of Self",
    description: "Support for account access, subscriptions, entries, transcripts, AI-assisted reflections, live questions, and local exports.",
    href: siteRoutes.apps.voiceOfSelfSupport.href,
    email: voiceOfSelfConfig.supportEmail,
  },
  {
    name: "OverLit",
    description: "Support for gameplay, ads, rewarded unlocks, Full Version purchases, local progress, and device-specific issues.",
    href: siteRoutes.apps.overLitSupport.href,
    email: overLitConfig.supportEmail,
  },
  {
    name: "Take Me Somewhere",
    description: "Support for route suggestions, location permission, map providers, Compass Mode, Route Mode, and local preferences.",
    href: siteRoutes.apps.takeMeSomewhereSupport.href,
    email: takeMeSomewhereConfig.supportEmail,
  },
  {
    name: "AudioChoices",
    description: "Support for playback, Yes/No choices, the head-nod feature, the branching story tree, book unlocks, and on-device progress.",
    href: siteRoutes.apps.audioBookChoicesSupport.href,
    email: audioBookChoicesConfig.supportEmail,
  },
] as const;
---

<SiteLayout
  title="Support"
  description="Support directory for apps by Alek Jałtuszyk, with app-specific support pages and contact emails."
  pageType="content"
  canonicalHref={siteRoutes.support.href}
>
  <h1>Support</h1>

  <p>
    Choose the app you need help with. Each support page includes a focused email draft so
    the right details are easy to include.
  </p>

  <p>
    Please avoid sending sensitive personal information, private screenshots, journal text,
    recordings, precise location history, Health details, or another person's information unless
    it is needed for the support request.
  </p>

  <section aria-label="App support pages">
    {supportItems.map((item) => (
      <article>
        <h2>{item.name}</h2>
        <p>{item.description}</p>
        <p>
          <a href={item.href}>Open {item.name} support</a><br />
          Email: <code>{item.email}</code>
        </p>
      </article>
    ))}
  </section>

  <p>
    For general website questions, email <code>{siteConfig.contactEmail}</code>.
    For legal documents, start from the <a href={siteRoutes.legal.href}>Legal hub</a>.
  </p>

  <SiteFooter />
</SiteLayout>
