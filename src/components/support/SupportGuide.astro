---
// Shared email-first support. App-specific help stays in each app's config.
import "../../styles/support.css";
import "../../styles/waitlist-guide.css";
import ActionButton from "../landing/ui/ActionButton.astro";

interface Props {
  config: {
    readonly supportEmail: string;
    readonly supportMailtoHref: string;
    readonly supportGmailHref: string;
    readonly support: {
      readonly title: string;
      readonly includeItems: readonly string[];
      readonly privacyNote: string;
    };
  };
}
const { config } = Astro.props;
---
<div class="waitlist-guide support-guide">
  <section class="waitlist-guide__hero landing-surface">
    <p class="waitlist-guide__eyebrow">Support</p>
    <h1 class="waitlist-guide__title">{config.support.title}</h1>
    <p class="waitlist-guide__lead">Questions, feedback or a bug? Email the developer.</p>
    <a class="support-guide__email" href={`mailto:${config.supportEmail}`}>{config.supportEmail}</a>
    <div class="waitlist-guide__actions">
      <ActionButton href={config.supportMailtoHref}>Open your email app</ActionButton>
      <ActionButton href={config.supportGmailHref} variant="secondary">Open Gmail</ActionButton>
    </div>
    <p class="waitlist-guide__note">Nothing is sent automatically. Edit the draft and choose any attachments before sending.</p>
  </section>
  <section class="waitlist-guide__card landing-surface">
    <h2 class="waitlist-guide__card-title">What helps</h2>
    <p class="waitlist-guide__body">A short message is enough. Include what is relevant:</p>
    <ul class="waitlist-guide__list">
      {config.support.includeItems.map((item) => <li>{item}</li>)}
    </ul>
    <p class="waitlist-guide__body">{config.support.privacyNote}</p>
    <slot />
  </section>
</div>
