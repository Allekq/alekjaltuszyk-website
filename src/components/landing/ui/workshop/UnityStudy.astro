---
import "../../../../styles/landing/workshop/unity-study.css";
---

<div class="unity-study">
  <svg viewBox="0 0 320 230" fill="none" aria-hidden="true" focusable="false">
    <!-- A miniature greybox level: platforms, a player and a readable jump. -->
    <ellipse cx="162" cy="190" rx="125" ry="25" fill="#243326" opacity=".09" />
    <path d="m25 145 129-66 142 65-129 72Z" fill="#a8b49a" />
    <path d="m25 145 142 65v12L25 157Z" fill="#87977a" />
    <path d="m167 210 129-66v12l-129 66Z" fill="#bdc7b0" />
    <path d="m26 145 128-66 142 65-129 66Z" stroke="#dbe1cf" />
    <g stroke="#d5ddc7" stroke-width=".7" opacity=".6">
      <path d="m52 131 141 65m-115-79 141 65m-115-78 141 65m-116-78 141 65" />
      <path d="m54 158 129-66m-100 80 128-66m-99 79 128-66m-99 79 129-66" />
    </g>
    <!-- The lower platform and a stepped ledge share one ground plane. -->
    <path d="m76 143 66-34 50 23-67 35Z" fill="#edf0e1" />
    <path d="m76 143 49 24v13l-49-24Z" fill="#b4bea4" />
    <path d="m125 167 67-35v13l-67 35Z" fill="#d2dac3" />
    <path d="m187 102 37-19 48 23-38 20Z" fill="#f1f1e4" />
    <path d="m187 102 47 24v40l-47-23Z" fill="#b2bfa3" />
    <path d="m234 126 38-20v40l-38 20Z" fill="#d8dfca" />
    <path d="m174 145 13-7 18 9-13 7v8l-18-9Z" fill="#dfe5d2" />
    <path d="m165 158 13-7 18 9-13 7v7l-18-9Z" fill="#e8ecdc" />
    <!-- Selection bounds and a transform handle suggest a level in the editor. -->
    <g stroke="#6d8c72" stroke-width="1" stroke-dasharray="3 4" opacity=".8">
      <path d="m181 99 43-22 54 26v47l-44 23-53-27Zm0 0 53 27 44-23m-44 23v47" />
    </g>
    <path d="M141 138Q166 47 218 99" stroke="#a4ac93" stroke-width="1.7" stroke-dasharray="3 5" stroke-linecap="round" />
    <g transform="translate(141 140)">
      <ellipse class="unity-study__shadow" rx="13" ry="6" fill="#5a6e52" opacity=".24" />
    </g>
    <g transform="translate(141 139)">
      <g class="unity-study__player">
        <rect x="-8" y="-27" width="16" height="28" rx="8" fill="#c96443" />
        <path d="M-5-22v13" stroke="#ec9e76" stroke-width="3" stroke-linecap="round" />
        <circle cy="-34" r="8" fill="#eedcb9" />
        <path d="m4-35 2 1" stroke="#76634c" stroke-linecap="round" />
      </g>
    </g>
    <ellipse cx="218" cy="101" rx="12" ry="6" stroke="#839b70" stroke-width="1.5" />
    <path d="M247 89V60" stroke="#7c8b70" stroke-width="2" />
    <path d="m248 61 17 7-17 6Z" fill="#ca6545" />
    <g stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M65 112V83m-4 5 4-5 4 5" stroke="#6f916f" />
      <path d="m65 112 23 11m-6-7 6 7-8 1" stroke="#c57053" />
      <path d="m65 112-20 11m8-1-8 1 3-7" stroke="#719aab" />
    </g>
    <circle cx="65" cy="112" r="3" fill="#ebeddd" stroke="#7e8a73" />
  </svg>
  <span class="unity-study__caption">A little world. Tuned to feel right.</span>
</div>
