---
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<div
  class:list={["project-object", `project-object--${id}`]}
  aria-hidden="true"
  data-project-object={id}
>
  {id === "plankept" && (
    <div class="plan-stack">
      <div class="plan-sheet plan-sheet--back">
        <span>01</span>
        <i></i>
        <i></i>
        <i></i>
      </div>
      <div class="plan-sheet plan-sheet--middle">
        <span>02</span>
        <i></i>
        <i></i>
        <i></i>
      </div>
      <div class="plan-sheet plan-sheet--front">
        <span>
          A little more
          <br />
          follow-through.
        </span>
        <div class="plan-check">✓</div>
        <div class="plan-progress">
          <i></i>
        </div>
        <small>PLAN → DO → DONE</small>
      </div>
    </div>
  )}
  {id === "audio-book-choices" && (
    <div class="audio-book">
      <div class="audio-book__spine"></div>
      <div class="audio-book__pages"></div>
      <div class="audio-book__cover">
        <small>A STORY WITH</small>
        <span>
          more than
          <br />
          <em>one way.</em>
        </span>
        <svg class="audio-tree" viewBox="0 0 180 108">
          <g class="audio-tree__world">
            <path d="M90 104V80M90 80L45 60M90 80L135 60M45 60L22 36M45 60L68 36M135 60L112 36M135 60L158 36M22 36L10 10M22 36L34 10M68 36L56 10M68 36L80 10M112 36L100 10M112 36L124 10M158 36L146 10M158 36L170 10" />
            {[10, 34, 56, 80, 100, 124, 146, 170].map((x) => (
              <circle cx={x} cy="10" r="3" />
            ))}
            <circle class="audio-tree__reader" cx="0" cy="0" r="4" />
          </g>
        </svg>
        <b>↗</b>
      </div>
      <div class="audio-book__bookmark"></div>
    </div>
  )}
  {id === "overlit" && (
    <div class="arcade-board">
      {Array.from({ length: 16 }, (_, i) => (
        <span
          class:list={[
            "arcade-key",
            [2, 5, 7, 10, 13].includes(i) && "arcade-key--lit",
          ]}
          style={`--i:${i}`}
        >
          <i></i>
        </span>
      ))}
    </div>
  )}
  {id === "voice-of-self" && (
    <div class="voice-object">
      <div class="voice-object__ring"></div>
      <div class="voice-object__ring voice-object__ring--outer"></div>
      <div class="voice-object__bars">
        {[24, 44, 68, 100, 74, 48, 84, 112, 62, 38, 24].map((h, i) => (
          <i style={`--bar:${h}px;--i:${i}`}></i>
        ))}
      </div>
      <div class="voice-object__speech">
        <i></i>
        <i></i>
        <i></i>
      </div>
      <span>A little perspective.</span>
    </div>
  )}
  {id === "take-me-somewhere" && (
    <div class="map-object">
      <div class="map-object__sheet">
        <svg viewBox="0 0 300 240">
          <g class="map-object__place">
            <path
              class="map-streets"
              d="M0 40H300M0 90H300M0 170H300M60 0V240M140 0V240M240 0V240M0 220L300 10"
            />
            <path class="map-park" d="M161 108h55v40h-55zM12 110h30v44H12z" />
            <path class="map-route" d="M60 190V90H140V40H240" />
            <circle cx="60" cy="190" r="6" />
            <circle cx="240" cy="40" r="9" />
          </g>
          <g class="map-object__place">
            <path
              class="map-water"
              d="M0 0H155Q80 75 146 122Q195 160 125 240H0Z"
            />
            <path
              class="map-streets"
              d="M170 0Q100 70 176 129T161 240M180 70L300 15M190 155L300 100M160 210L300 195"
            />
            <path
              class="map-park"
              d="M230 25l45 20-30 35-35-12zM242 144l40-12 4 38-45 8z"
            />
            <path
              class="map-route"
              d="M161 211Q205 155 174 116T173 38L236 27"
            />
            <circle cx="161" cy="211" r="6" />
            <circle cx="236" cy="27" r="9" />
          </g>
          <g class="map-object__place">
            <path class="map-water" d="M90 0h32v240H90zM0 110h300v24H0z" />
            <path
              class="map-streets"
              d="M0 40H300M0 190H300M42 0V240M170 0V240M260 0V240M0 120H300"
            />
            <path
              class="map-blocks"
              d="M181 50h62v46h-62zM181 145h62v30h-62zM10 54h20v42H10zM132 145h24v30h-24z"
            />
            <path class="map-park" d="M180 200h62v30h-62z" />
            <path class="map-route" d="M42 205V120H170V40H260V78" />
            <circle cx="42" cy="205" r="6" />
            <circle cx="260" cy="78" r="9" />
          </g>
          <g class="map-object__place">
            <path
              class="map-streets"
              d="M150 0V240M0 120H300M0 15L300 225M0 225L300 15M30 0Q155 210 280 0M30 240Q155 30 280 240"
            />
            <circle class="map-plaza" cx="150" cy="120" r="35" />
            <path
              class="map-blocks"
              d="M42 75l24-26 34 24-19 18zM208 163l20-21 28 24-21 20zM168 20h35v26h-35z"
            />
            <path
              class="map-route"
              d="M40 197L125 137Q105 95 150 85Q180 84 183 115L258 120"
            />
            <circle cx="40" cy="197" r="6" />
            <circle cx="258" cy="120" r="9" />
          </g>
          <g class="map-object__place">
            <path
              class="map-water"
              d="M0 152Q75 80 150 140T300 120V155Q225 220 150 175T0 190Z"
            />
            <path
              class="map-streets"
              d="M40 0V240M120 0V240M215 0V240M280 0V240M0 35H300M0 90H300M0 220H300"
            />
            <path
              class="map-blocks"
              d="M53 48h54v29H53zM136 48h64v29h-64zM232 48h32v29h-32zM54 195h50v14H54z"
            />
            <path class="map-park" d="M136 4h63v20h-63zM228 174h38v29h-38z" />
            <path class="map-route" d="M280 220H215V90H120V35H40" />
            <circle cx="280" cy="220" r="6" />
            <circle cx="40" cy="35" r="9" />
          </g>
        </svg>
        <i></i>
        <i></i>
      </div>
      <div class="map-object__pin">
        <span>↗</span>
      </div>
      <span class="map-object__coordinate">A little further.</span>
    </div>
  )}
</div>
