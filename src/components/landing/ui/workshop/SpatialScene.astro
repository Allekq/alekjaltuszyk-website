---
import { withBase } from "../../../../lib/paths";
import { apps } from "../../../../lib/appState";
interface Props {
  scene: "island" | "terrain" | "world" | "products";
  caption: string;
  action?: string;
}
const { scene, caption, action } = Astro.props;
---

<div
  class:list={["w-spatial", `w-spatial--${scene}`]}
  data-spatial-scene={scene}
  data-product-ids={
    scene === "products" ? apps.map((app) => app.id).join(",") : undefined
  }
>
  <div class="w-spatial__drawing" aria-hidden="true">
    <img
      class="w-spatial__fallback"
      src={withBase(`/media/home/workshop-${scene}.webp`)}
      alt=""
      width="800"
      height="700"
      loading={scene === "island" ? "eager" : "lazy"}
    />
    <canvas class="w-spatial__canvas"></canvas>
  </div>
  <span class="w-spatial__caption">{caption}</span>
  {action && (
    <button class="w-spatial__action" type="button" data-spatial-action hidden>
      <span data-action-label>{action}</span>
      <span aria-hidden="true">↗</span>
    </button>
  )}
</div>
