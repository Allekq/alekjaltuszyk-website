---
import { withBase } from "../../../../lib/paths";
import "../../../../styles/landing/workshop/asset-proof.css";

const placerUrl =
  "https://assetstore.unity.com/packages/tools/level-design/placer-3-pro-level-designer-283376";
const controllerUrl =
  "https://assetstore.unity.com/packages/tools/physics/prpc-parkour-rigidbody-player-controller-229619";
const hovercraftUrl =
  "https://assetstore.unity.com/packages/tools/physics/hovercraft-system-212594";
const frameworkUrl =
  "https://assetstore.unity.com/packages/tools/behavior-ai/alek-ai-framework-263561";

const screenshots = [
  {
    image: "/media/home/assets/placer-level-design.png",
    width: 815,
    height: 455,
    name: "Placer 3 PRO",
    alt: "A fenced low-poly landscape from the Placer Asset Store gallery",
    url: placerUrl,
  },
  {
    image: "/media/home/assets/prpc-inspector.jpg",
    width: 1259,
    height: 900,
    name: "PRPC · player controller",
    alt: "The real PRPC Unity inspector with movement settings and events",
    url: controllerUrl,
  },
  {
    image: "/media/home/assets/alek-ai-gameplay.webp",
    width: 960,
    height: 540,
    name: "Alek AI · enemy framework",
    alt: "Enemy characters in the Unity editor, from the Alek AI Framework demo",
    url: frameworkUrl,
  },
];

const reviews = [
  {
    quote: "Great asset and Incredible support!",
    author: "JoelioRochon",
    product: "Placer 3 PRO",
    version: "previous version 1.1.0",
    url: `${placerUrl}#reviews`,
  },
  {
    quote: "Works out of the box and developer support is excellent",
    author: "Hitmonsashi",
    product: "PRPC",
    version: "version 1.3",
    url: `${controllerUrl}#reviews`,
  },
  {
    quote: "Really amazing",
    author: "Phobeaphobe",
    product: "HoverCraft System",
    version: "version 2.1.2",
    url: `${hovercraftUrl}#reviews`,
  },
  {
    quote: "Powerful and easy to use",
    author: "Hitmonsashi",
    product: "Alek AI Framework",
    version: "previous version 1.0",
    url: `${frameworkUrl}#reviews`,
  },
];
---

<div class="asset-proof">
  <p class="asset-proof__label">From the Asset Store</p>
  <div
    class="asset-proof__screenshots"
    role="region"
    aria-label="Unity tools; scroll horizontally to explore"
    tabindex="0"
  >
    {screenshots.map((shot) => (
      <a
        class="asset-proof__image-link"
        href={shot.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Explore ${shot.name} on the Asset Store (opens in a new tab)`}
      >
        <img
          src={withBase(shot.image)}
          alt={shot.alt}
          width={shot.width}
          height={shot.height}
          loading="lazy"
          decoding="async"
        />
        <span class="asset-proof__pill">
          {shot.name}
          <span aria-hidden="true">↗</span>
        </span>
      </a>
    ))}
  </div>
  <p class="asset-proof__swipe">
    Scroll to explore the tools <span aria-hidden="true">→</span>
  </p>

  <p class="asset-proof__label asset-proof__label--reviews">
    Selected developer reviews
  </p>
  <p class="asset-proof__intro">
    A few words from the developers who used the tools.
  </p>
  <div class="asset-proof__reviews">
    {reviews.map((review) => (
      <figure class="asset-proof__review">
        <span
          class="asset-proof__stars"
          role="img"
          aria-label="5 out of 5 stars"
        >
          ★★★★★
        </span>
        <blockquote cite={review.url}>“{review.quote}”</blockquote>
        <figcaption>
          <span>{review.author}</span>
          <a href={review.url} target="_blank" rel="noopener noreferrer">
            {review.product} · {review.version}{" "}
            <span aria-hidden="true">↗</span>
          </a>
        </figcaption>
      </figure>
    ))}
  </div>
</div>
