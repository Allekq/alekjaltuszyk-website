---
import ArrowIcon from "../ArrowIcon.astro";
import UnityStudy from "./UnityStudy.astro";
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<div class:list={["skill-object", `skill-object--${id}`]} aria-hidden="true">
  {id === "unity" && <UnityStudy />}
  {id === "csharp" && (
    <div class="skill-modules">
      <div>
        <span>interface</span>
        <b>IExperience</b>
      </div>
      <div>
        <span>compose</span>
        <b>Systems&lt;T&gt;</b>
      </div>
      <div>
        <span>implement</span>
        <b>MakeItWork()</b>
      </div>
    </div>
  )}
  {id === "ai" && (
    <div class="skill-ai">
      <div class="skill-ai__input">
        an idea<span><ArrowIcon direction="down-right" /></span>
      </div>
      <div class="skill-ai__core">
        <span>{"{ }"}</span>
      </div>
      <div class="skill-ai__output">
        <i>✓</i> validated state
      </div>
    </div>
  )}
</div>
