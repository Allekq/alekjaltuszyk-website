---
/**
 * Sticky header shared by the standalone app landing pages.
 *
 * Reuses the `landing-header` hooks so `sticky-header.ts` and
 * `active-section-nav.ts` light it up with no extra wiring. Each page re-skins
 * it from its own stylesheet; nothing about the palette lives here.
 */
import ActionButton from "./ActionButton.astro";
import { isExternalHref } from "../../../lib/paths";

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  brand: string;
  brandHref: string;
  iconAlt?: string;
  iconSrc?: string;
  navigation?: readonly NavItem[];
  ctaHref?: string;
  ctaLabel?: string;
  ctaNote?: string;
}

const {
  brand,
  brandHref,
  iconAlt,
  iconSrc,
  navigation = [],
  ctaHref,
  ctaLabel,
  ctaNote,
} = Astro.props as Props;

const getSectionId = (href: string) => (href.startsWith("#") ? href.slice(1) : undefined);
const isExternalCta = ctaHref ? isExternalHref(ctaHref) && !ctaHref.startsWith("#") : false;
---

<header class="landing-header app-header" data-landing-header>
  <div class="app-header__inner">
  <div class="landing-header__bar app-header__bar landing-surface">
    <a class="landing-brand app-header__brand" href={brandHref}>
      {iconSrc && (
        <img
          class="app-header__icon"
          src={iconSrc}
          alt={iconAlt ?? ""}
          width="40"
          height="40"
          decoding="async"
        />
      )}
      <span>{brand}</span>
    </a>

    {navigation.length > 0 && (
      <nav class="landing-nav app-header__nav" aria-label="Sections" data-nav-root>
        <span class="landing-nav__highlight" aria-hidden="true" data-nav-highlight></span>
        {navigation.map((item, index) => (
          <a
            class:list={["landing-nav__link", index === 0 && "is-active"]}
            href={item.href}
            data-nav-pill
            data-section-id={getSectionId(item.href)}
            aria-current={index === 0 ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    )}

    {ctaHref && ctaLabel ? (
      <ActionButton
        className="landing-header__cta app-header__cta"
        href={ctaHref}
        target={isExternalCta ? "_blank" : undefined}
      >
        {ctaLabel}
      </ActionButton>
    ) : (
      ctaNote && <span class="app-header__note">{ctaNote}</span>
    )}
  </div>
  </div>
</header>
