---
import { siteConfig } from "../../../config/site";

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  brand?: string;
  brandHref?: string;
  links?: readonly FooterLink[];
  socialLinks?: readonly FooterLink[];
  showBrand?: boolean;
  showSocials?: boolean;
}

const {
  brand = siteConfig.name,
  brandHref = siteConfig.homeHref,
  links = siteConfig.footerLinks,
  socialLinks = siteConfig.socialLinks,
  showBrand = true,
  showSocials = true,
} = Astro.props as Props;
---

<footer class="site-footer">
  <div class="site-footer__inner landing-surface">
    {showBrand ? (
      <a class="site-footer__brand" href={brandHref}>{brand}</a>
    ) : null}

    <nav class="site-footer__links" aria-label="Footer">
      {links.map((link) => (
        <a
          href={link.href}
          target={"external" in link && link.external ? "_blank" : undefined}
          rel={"external" in link && link.external ? "noreferrer" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    {showSocials && socialLinks.length > 0 ? (
      <nav class="site-footer__socials" aria-label="Social links">
        {socialLinks.map((link) => (
          <a
            class="site-footer__social-link"
            href={link.href}
            target={"external" in link && link.external ? "_blank" : undefined}
            rel={"external" in link && link.external ? "noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    ) : null}

    <p class="site-footer__copy">{siteConfig.footerText}</p>
  </div>
</footer>
