---
const lines = [
  [{ text: 'ideas', kind: 'name' }, { text: ' = [' }, { text: '"learn"', kind: 'string' }, { text: ', ' }, { text: '"build"', kind: 'string' }, { text: ']' }],
  [{ text: '' }],
  [{ text: 'for ', kind: 'keyword' }, { text: 'idea', kind: 'name' }, { text: ' in ', kind: 'keyword' }, { text: 'ideas:' }],
  [{ text: '    ' }, { text: 'print', kind: 'name' }, { text: '(' }, { text: 'f"Let’s {idea}."', kind: 'string' }, { text: ')' }],
];
---
<figure class="cw-sketch">
  <cw-code-sketch aria-hidden="true">
    <div class="sketch-header"><span class="sketch-file">ideas.py</span><span>Python</span></div>
    <div class="sketch-source">
      {lines.map((line, index) => <div class="sketch-line" data-line>
        <span class="sketch-number">{index + 1}</span>
        <code>{line.map((token) => <span class:list={[token.kind && `sketch-${token.kind}`]} data-code={token.text}>{token.text}</span>)}<span class="sketch-caret"></span></code>
      </div>)}
    </div>
    <div class="sketch-output">
      <span class="sketch-label">Output</span>
      <div data-output><span>Let’s learn.</span><span>Let’s build.</span></div>
    </div>
    <div class="sketch-footer"><span class="sketch-dot"></span>One idea at a time.</div>
  </cw-code-sketch>
  <figcaption>A few lines. A new possibility.</figcaption>
</figure>
<script>
  import "../../../../scripts/landing/code-workroom-sketch";
</script>
<style>
  .cw-sketch { margin: 0; min-width: 0; }
  cw-code-sketch { display: block; overflow: hidden; border: 1px solid var(--cw-line); border-radius: var(--radius-lg); background: color-mix(in srgb, var(--cw-panel) 48%, var(--cw-paper)); box-shadow: 0 24px 64px -32px color-mix(in srgb, var(--cw-ink) 28%, transparent); }
  .sketch-header { display: flex; justify-content: space-between; align-items: center; padding: var(--space-lg) var(--space-xl); border-bottom: 1px solid var(--cw-line); color: var(--cw-muted); font: .75rem/1.5 ui-monospace, monospace; }
  .sketch-file { color: var(--cw-ink); }
  .sketch-source { padding: var(--space-2xl) var(--space-lg); font: clamp(.78rem, 1.2vw, 1.1rem)/2.1 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .sketch-line { display: grid; grid-template-columns: 2ch minmax(0, 1fr); gap: var(--space-md); }
  .sketch-number { color: var(--cw-muted); opacity: .65; font-size: .72em; text-align: right; }
  code { min-height: 2.1em; white-space: pre; font: inherit; }
  .sketch-name { color: var(--cw-accent); }
  .sketch-string { color: light-dark(#286449, #a8d5b7); }
  .sketch-keyword { color: light-dark(#78509a, #ceb1ed); }
  .sketch-caret { display: none; height: 1.15em; width: 2px; margin-left: 1px; background: var(--cw-accent); vertical-align: -.18em; }
  [data-active] .sketch-caret { display: inline-block; }
  .sketch-output { margin: 0 var(--space-xl); padding: var(--space-lg) 0; border-top: 1px solid var(--cw-line); min-height: 7.25rem; }
  .sketch-label { display: block; color: var(--cw-muted); font: .65rem/1.5 ui-monospace, monospace; text-transform: uppercase; letter-spacing: .1em; margin-bottom: var(--space-sm); }
  [data-output] { display: grid; gap: var(--space-2xs); color: var(--cw-ink); font: .85rem/1.6 ui-monospace, monospace; }
  .sketch-footer { display: flex; align-items: center; gap: var(--space-xs); padding: var(--space-md) var(--space-xl); border-top: 1px solid var(--cw-line); color: var(--cw-muted); font-size: .7rem; }
  .sketch-dot { width: .4rem; height: .4rem; border-radius: 50%; background: var(--cw-accent); }
  figcaption { color: var(--cw-muted); font-size: .85rem; line-height: 1.6; margin-top: var(--space-md); }
  @media (max-width: 900px) { .cw-sketch { width: 100%; max-width: 44rem; } .sketch-source { font-size: clamp(.8rem, 3.6vw, 1.2rem); } }
  @media (max-width: 400px) { .sketch-source { padding-inline: var(--space-sm); } .sketch-line { gap: var(--space-xs); } }
</style>
