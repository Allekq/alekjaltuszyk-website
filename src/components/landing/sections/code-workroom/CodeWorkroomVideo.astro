---
import { codeWorkroomMedia } from "../../../../config/codeWorkroomMedia";
import { withBase } from "../../../../lib/paths";
const { heroVideo } = codeWorkroomMedia;
---
{heroVideo && <figure class="cw-video">
  <video controls muted playsinline preload="none" width="1200" height="900" poster={withBase(heroVideo.poster)} aria-label="Code Workroom IDE app demonstration" aria-describedby="cw-video-caption cw-video-description">
    <source src={withBase(heroVideo.src)} type="video/mp4" />
    <p><a href={withBase(heroVideo.src)}>Watch the Code Workroom IDE video</a>.</p>
  </video>
  <figcaption id="cw-video-caption">{heroVideo.caption}</figcaption>
  <details><summary>Video description</summary><p id="cw-video-description">{heroVideo.transcript}</p></details>
</figure>}
