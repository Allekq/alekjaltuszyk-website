---
import { siteConfig } from "../../../config/site";
import { withBase } from "../../../lib/paths";

/*
 * Two encodes of the same decorative loop. The source master was 4K at 70
 * Mbit/s — 87 MB for ten seconds of background texture, which is most of a
 * phone's patience spent on something sitting behind a near-opaque gradient.
 * The script picks by viewport width and never loads either one on a
 * reduced-motion or data-saver visit.
 */
const heroVideoWidePath = withBase("/media/home/hero-energy-loop-1080.mp4");
const heroVideoNarrowPath = withBase("/media/home/hero-energy-loop-720.mp4");
const heroPosterPath = withBase("/media/home/hero-energy-poster-1280.jpg");
const heroNameLines = siteConfig.preferredName.split(" ");
---

<section class="home-video-hero" id="home">
  <div class="home-video-hero__media" aria-hidden="true">
    <video
      class="home-video-hero__video"
      autoplay
      loop
      muted
      playsinline
      poster={heroPosterPath}
      preload="none"
      data-hero-video
    >
      <source
        data-src={heroVideoWidePath}
        data-src-narrow={heroVideoNarrowPath}
        type="video/mp4"
      />
    </video>
  </div>

  <div class="home-video-hero__inner">
    <div class="home-video-hero__copy">
      <p class="home-video-hero__kicker">Software engineer / AI systems / Unity craft</p>
      <h1 class="home-video-hero__title">
        {heroNameLines.map((line) => (
          <span>{line}</span>
        ))}
      </h1>
      <p class="home-video-hero__summary">
        Building products where intelligence, behavior, and a little useful pressure meet.
      </p>
      <a class="home-video-hero__cue" href="#about">Current work</a>
    </div>
  </div>
</section>

<script>
  import "../../../scripts/landing/home-hero-video";
</script>
