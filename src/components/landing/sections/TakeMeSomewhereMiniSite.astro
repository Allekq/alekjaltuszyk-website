---
import TakeMeSomewherePageOrchestrator from "../orchestrator/TakeMeSomewherePageOrchestrator.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { buildAppStructuredData } from "../../../lib/appSchema";
import { siteRoutes } from "../../../config/routes";
import { takeMeSomewhereConfig } from "../../../config/site";

const structuredData = buildAppStructuredData({
  name: takeMeSomewhereConfig.name,
  alternateNames: takeMeSomewhereConfig.alternateNames,
  path: siteRoutes.apps.takeMeSomewhere.path,
  description: takeMeSomewhereConfig.defaultDescription,
  applicationCategory: "TravelApplication",
  applicationSubCategory: "Walking route discovery",
  operatingSystem: "iOS",
  downloadUrl: takeMeSomewhereConfig.appStoreHref,
  featureList: takeMeSomewhereConfig.aiDiscovery.featureList,
});
---

<SiteLayout
  title={takeMeSomewhereConfig.homeTitle}
  description={takeMeSomewhereConfig.defaultDescription}
  pageType="landing"
  structuredData={structuredData}
  faviconHref={takeMeSomewhereConfig.faviconHref}
  faviconType={takeMeSomewhereConfig.faviconType}
>
  <TakeMeSomewherePageOrchestrator />
</SiteLayout>
