---
import TakeMeSomewherePageOrchestrator from "../orchestrator/TakeMeSomewherePageOrchestrator.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { siteConfig, takeMeSomewhereConfig } from "../../../config/site";
import { siteRoutes } from "../../../config/routes";
import { toAbsoluteSiteUrl } from "../../../lib/discovery";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: takeMeSomewhereConfig.name,
    applicationCategory: "NavigationApplication",
    operatingSystem: "iOS",
    url: toAbsoluteSiteUrl(siteRoutes.apps.takeMeSomewhere.path),
    description: takeMeSomewhereConfig.defaultDescription,
    author: {
      "@type": "Person",
      name: siteConfig.legalName,
    },
  },
];
---

<SiteLayout
  title={takeMeSomewhereConfig.homeTitle}
  description={takeMeSomewhereConfig.defaultDescription}
  pageType="landing"
  structuredData={structuredData}
  faviconHref={takeMeSomewhereConfig.faviconHref}
  faviconType={takeMeSomewhereConfig.faviconType}
>
  <TakeMeSomewherePageOrchestrator />
</SiteLayout>
