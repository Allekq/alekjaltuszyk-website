---
import { audioBookChoicesConfig } from "../../../../config/site";

/*
 * The shelf shows the spread, not the inventory.
 *
 * It used to pair three abstract covers with a genre and an age each, plus an
 * "in production" tile. All of that was a standing claim about how many books
 * exist and how old you have to be for them, and all of it went stale: the
 * catalogue has grown, and advisory ages now come from a fixed set the app
 * enforces rather than from per-book guesses. Genres are the part that stays
 * true as books are added, so genres are what this says — with the ages left to
 * the age-suitability page, which is the one place that states them.
 */
const genres = [
  "Thriller",
  "Drama",
  "Crime",
  "Survival",
  "Science-fiction",
  "Mythology",
  "Comedy",
  "Adventure",
] as const;

const promises = [
  {
    title: "Written and narrated in full, before you press play",
    body: "Every branch is produced and checked ahead of publication. Nothing is generated while you listen.",
  },
  {
    title: "A shelf that matches what you asked for",
    body: "A short setup shapes what shows up. It is worked out on your device from what you told the app — no profile, no tracking, nothing to sign up for.",
  },
  {
    title: "New books, same app",
    body: "Books are content, not updates. New ones appear across genres without you chasing a release.",
  },
] as const;
---

<section class="app-section abc-library" id="library">
  <div class="app-shell">
    <header class="app-section__head app-section__head--centre" data-rise>
      <p class="app-eyebrow">The shelf</p>
      <h2 class="app-title">Whole books, finished before they ship.</h2>
      <p class="app-lead">
        Every branch written, narrated and checked before a book goes on the shelf — across a
        widening spread of genres rather than one house style.
      </p>
    </header>

    <ul class="abc-library__genres" data-rise>
      {genres.map((genre) => (
        <li class="app-chip">{genre}</li>
      ))}
      <li class="app-chip abc-library__genres-more">and more</li>
    </ul>

    <p class="abc-library__ages" data-rise>
      Books carry their own advisory minimum age, and the shelf offers a listener only what fits
      the age the app has for them.
      <a href={audioBookChoicesConfig.ageSuitabilityHref}>What the stories contain</a>
      sets out exactly what that means.
    </p>

    <ul class="abc-library__promises">
      {promises.map((promise, index) => (
        <li class="abc-library__promise" data-rise style={`--rise-index:${index}`}>
          <h3 class="abc-library__promise-title">{promise.title}</h3>
          <p class="abc-library__promise-body">{promise.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
