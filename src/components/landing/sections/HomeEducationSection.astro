---
import { siteConfig } from "../../../config/site";
---

<section class="home-education" id="education" aria-labelledby="home-education-title">
  <div class="home-education__inner">
    <h2 class="home-education__title" id="home-education-title">Education</h2>
    <details class="home-education__card">
      <summary>
        <span class="home-education__school">Warsaw University of Technology</span>
        <span class="home-education__course">Computer Science · WEiTI</span>
        <span class="home-education__toggle" aria-hidden="true">+</span>
      </summary>
      <p>{siteConfig.identity.education} Studies in progress.</p>
    </details>
  </div>
</section>
