---
import AudioBookChoicesPageOrchestrator from "../orchestrator/AudioBookChoicesPageOrchestrator.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { audioBookChoicesConfig } from "../../../config/site";
import { buildAppStructuredData } from "../../../lib/appSchema";
import { siteRoutes } from "../../../config/routes";

const structuredData = buildAppStructuredData({
  name: audioBookChoicesConfig.name,
  alternateNames: audioBookChoicesConfig.alternateNames,
  path: siteRoutes.apps.audioBookChoices.path,
  description: audioBookChoicesConfig.defaultDescription,
  applicationCategory: "BooksApplication",
  applicationSubCategory: "Interactive audiobooks",
  /* Both stores are live, so both are claimed. This is a machine-readable
     statement about what someone can install today, not about what is being
     built — keep it in step with `platforms` in `routes.ts`. */
  operatingSystem: "iOS, Android",
  downloadUrl: [
    audioBookChoicesConfig.appStoreHref,
    audioBookChoicesConfig.playStoreHref,
  ],
  contentRating: "13+",
  isAccessibleForFree: true,
  featureList: audioBookChoicesConfig.aiDiscovery.featureList,
});
---

<SiteLayout
  title={audioBookChoicesConfig.homeTitle}
  description={audioBookChoicesConfig.defaultDescription}
  pageType="landing"
  structuredData={structuredData}
  faviconHref={audioBookChoicesConfig.faviconHref}
  faviconType={audioBookChoicesConfig.faviconType}
>
  <AudioBookChoicesPageOrchestrator />
</SiteLayout>
