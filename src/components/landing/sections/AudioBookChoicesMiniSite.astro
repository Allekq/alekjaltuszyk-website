---
import SimpleSiteHeader from "./SimpleSiteHeader.astro";
import { audioBookChoicesConfig, siteConfig } from "../../../config/site";
import { siteRoutes } from "../../../config/routes";
import { toAbsoluteSiteUrl } from "../../../lib/discovery";
import SiteLayout from "../../../layouts/SiteLayout.astro";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: audioBookChoicesConfig.name,
    applicationCategory: "EntertainmentApplication",
    operatingSystem: "iOS, Android",
    url: toAbsoluteSiteUrl(siteRoutes.apps.audioBookChoices.path),
    description: audioBookChoicesConfig.defaultDescription,
    author: {
      "@type": "Person",
      name: siteConfig.legalName,
    },
  },
];
---

<SiteLayout
  title={audioBookChoicesConfig.homeTitle}
  description={audioBookChoicesConfig.defaultDescription}
  pageType="landing"
  structuredData={structuredData}
>
  <div class="abc-simple-site" aria-labelledby="abc-title">
    <SimpleSiteHeader
      brand={audioBookChoicesConfig.name}
      brandHref={audioBookChoicesConfig.homeHref}
    />

    <main class="abc-simple-site__main">
      <p class="abc-simple-site__eyebrow">iOS &amp; Android</p>
      <h1 id="abc-title">Audio Book Choices</h1>
      <div class="abc-simple-site__copy">
        <p>
          Audio Book Choices is an interactive &ldquo;choose your story&rdquo; audiobook app. You
          listen to an AI-narrated story and steer where it goes with simple Yes or No choices,
          made by tapping the screen or nodding your head with AirPods.
        </p>
        <p>
          Every book is a branching story tree. Your choices open new paths, and you can explore
          the tree to see where other decisions would have led. Your listening progress, your
          choices and your settings stay on your device &mdash; there is no sign-up, and the app
          never asks for your name, email address or phone number.
        </p>
        <p>
          Every installation gets three free unlocks. After that you can buy a single book
          outright or take the All Access subscription, both handled through the App Store and
          Google Play at the price shown before you buy. Purchases are tied to an anonymous identifier for your
          installation, which is what lets them be restored later &mdash; the
          <a href={audioBookChoicesConfig.privacyHref}>Privacy Policy</a> explains exactly what that
          is and what is stored.
        </p>
        <p>
          There is no analytics tool, no crash reporting, no advertising and no tracking anywhere
          in the app.
        </p>
      </div>
    </main>

    <footer class="abc-simple-site__footer">
      <nav aria-label="Audio Book Choices links">
        <a href={audioBookChoicesConfig.supportHref}>Support</a>
        <a href={audioBookChoicesConfig.privacyHref}>Privacy Policy</a>
        <a href={audioBookChoicesConfig.termsHref}>Terms of Use</a>
        <a href={siteRoutes.apps.index.href}>Apps</a>
        <a href={siteRoutes.home.href}>Home</a>
      </nav>
    </footer>
  </div>
</SiteLayout>
