---
import AudioBookChoicesPageOrchestrator from "../orchestrator/AudioBookChoicesPageOrchestrator.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { audioBookChoicesConfig, siteConfig } from "../../../config/site";
import { siteRoutes } from "../../../config/routes";
import { toAbsoluteSiteUrl } from "../../../lib/discovery";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: audioBookChoicesConfig.name,
    applicationCategory: "EntertainmentApplication",
    operatingSystem: "iOS, Android",
    url: toAbsoluteSiteUrl(siteRoutes.apps.audioBookChoices.path),
    description: audioBookChoicesConfig.defaultDescription,
    author: {
      "@type": "Person",
      name: siteConfig.legalName,
    },
  },
];
---

<SiteLayout
  title={audioBookChoicesConfig.homeTitle}
  description={audioBookChoicesConfig.defaultDescription}
  pageType="landing"
  structuredData={structuredData}
  faviconHref={audioBookChoicesConfig.faviconHref}
  faviconType={audioBookChoicesConfig.faviconType}
>
  <AudioBookChoicesPageOrchestrator />
</SiteLayout>
