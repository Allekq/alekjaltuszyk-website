---
/*
 * Scroll-driven app showcase, shared by the homepage and /apps.
 *
 * One app owns the stage at a time. The left column is a stack of beats that
 * scroll normally; the right column is pinned and cross-fades artwork as each
 * beat takes over.
 *
 * Timing lives in `src/scripts/landing/app-showcase.ts`, which measures each
 * beat against the pinned panel rather than against the section — see the note
 * there for why the shared scroll-scene engine is the wrong tool here. This
 * file only has to mark the parts: the stage, the beats, the artwork layers,
 * and the rail rows, in matching order.
 *
 * Every app comes from `appDirectory`, so adding one adds a beat.
 */
import { apps, directoryChips } from "../../../../lib/appState";
import { isExternalHref } from "../../../../lib/paths";

interface Props {
  /** Where the "skip this" control sends people. Omitted on pages with no grid. */
  gridHref?: string;
  headingLevel?: "h2" | "h3";
}

const { gridHref, headingLevel = "h2" } = Astro.props as Props;
const Heading = headingLevel;
---

<section class="app-showcase" id="showcase" aria-label="Apps, one at a time">
  <div class="app-showcase__scene" data-showcase>
    <div class="app-showcase__beats">
      {apps.map((item, index) => {
        const rel =
          item.external && isExternalHref(item.href) ? "noreferrer" : undefined;

        return (
          <article
            class:list={["app-showcase__beat", `app-showcase__beat--${item.theme}`]}
            data-showcase-beat
          >
            <p class="app-showcase__index">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span class="app-showcase__index-total">/ {apps.length}</span>
            </p>

            <Heading class="app-showcase__pitch">{item.pitch}</Heading>
            <p class="app-showcase__name">{item.name}</p>
            <p class="app-showcase__body">{item.description}</p>

            <ul class="app-showcase__chips">
              {directoryChips(item).map((chip) => (
                <li>{chip}</li>
              ))}
            </ul>

            <a
              class="app-showcase__link"
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={rel}
            >
              {item.external ? `${item.shortName} on the App Store` : `Open ${item.shortName}`}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        );
      })}
    </div>

    <div class="app-showcase__stage" data-showcase-stage>
      <div class="app-showcase__frame">
        {/*
          Artwork layers stack in source order and each one fades up on its own
          beat, so the newest active layer simply covers the previous one. There
          is no fade-out pass, which is what leaves the last app on the stage
          once its beat has scrolled by.
        */}
        <div class="app-showcase__art" aria-hidden="true">
          {apps.map((item, index) => (
            <span
              class:list={["app-showcase__art-layer", `app-showcase__art-layer--${item.theme}`]}
              style={`z-index:${index + 1};`}
              data-showcase-layer
            >
              <img
                src={item.iconHref}
                alt=""
                width="128"
                height="128"
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </span>
          ))}
        </div>

        <ol class="app-showcase__rail">
          {apps.map((item) => (
            <li class="app-showcase__tick" data-showcase-tick>
              <span class="app-showcase__tick-dot" aria-hidden="true"></span>
              <span class="app-showcase__tick-label">{item.shortName}</span>
            </li>
          ))}
        </ol>
      </div>

      {gridHref && (
        <a class="app-showcase__skip" href={gridHref} data-scroll-to>
          See the grid instead
        </a>
      )}
    </div>
  </div>
</section>
