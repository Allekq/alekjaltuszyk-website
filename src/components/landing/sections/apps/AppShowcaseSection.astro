---
/*
 * Scroll-driven app showcase, shared by the homepage and /apps.
 *
 * One app owns the stage at a time. The left column is a stack of beats that
 * scroll normally; the right column is pinned and cross-fades artwork as each
 * beat takes over. Both sides are driven by the same `[data-scene]` engine in
 * `src/scripts/landing/motion/scroll-scene.ts`, so there is no bespoke
 * JavaScript here — only `--item-progress` read from CSS.
 *
 * Every app comes from `appDirectory`, so adding one adds a beat.
 */
import { apps, directoryChips } from "../../../../lib/appState";
import { isExternalHref } from "../../../../lib/paths";

interface Props {
  /** Where the "skip this" control sends people. Omitted on pages with no grid. */
  gridHref?: string;
  headingLevel?: "h2" | "h3";
}

const { gridHref, headingLevel = "h2" } = Astro.props as Props;
const Heading = headingLevel;

/*
 * The scene has three parallel tracks — the beats, the artwork layers, and the
 * rail — and each one has an entry per app. Left to itself the engine spreads
 * every `[data-scene-item]` it finds evenly in DOM order, which would run the
 * tracks one after another instead of together. Stating `data-item-at`
 * explicitly is what keeps app N's text, icon, and rail row on the same moment.
 *
 * The constants are the measured relationship between pin progress and where a
 * beat sits on screen: beat N crosses the middle of the viewport at roughly
 * `FIRST_BEAT_AT + N * gap`, so each item's ramp is timed to *finish* there.
 * The stage lands on an app exactly as you start reading about it. The first
 * value is negative because the opening beat is already centred before the
 * stage starts pinning — which is what puts an icon on the stage on arrival
 * rather than an empty frame. Re-measure these if the beat spacing changes.
 */
const FIRST_BEAT_AT = -0.18;
const LAST_BEAT_AT = 0.99;
const beatGap =
  apps.length > 1
    ? (LAST_BEAT_AT - FIRST_BEAT_AT) / (apps.length - 1)
    : 1;
const itemSpan = (beatGap * 0.8).toFixed(4);
const itemAt = (index: number) =>
  (FIRST_BEAT_AT + index * beatGap - beatGap * 0.8).toFixed(4);
---

<section class="app-showcase" id="showcase" aria-label="Apps, one at a time">
  <div class="app-showcase__scene" data-scene data-scene-mode="pin">
    <div class="app-showcase__beats">
      {apps.map((item, index) => {
        const rel =
          item.external && isExternalHref(item.href) ? "noreferrer" : undefined;

        return (
          <article
            class:list={["app-showcase__beat", "scene-beat", `app-showcase__beat--${item.theme}`]}
            data-scene-item
            data-item-at={itemAt(index)}
            data-item-span={itemSpan}
          >
            <p class="app-showcase__index">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span class="app-showcase__index-total">/ {apps.length}</span>
            </p>

            <Heading class="app-showcase__pitch">{item.pitch}</Heading>
            <p class="app-showcase__name">{item.name}</p>
            <p class="app-showcase__body">{item.description}</p>

            <ul class="app-showcase__chips">
              {directoryChips(item).map((chip) => (
                <li>{chip}</li>
              ))}
            </ul>

            <a
              class="app-showcase__link"
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={rel}
            >
              {item.external ? `${item.shortName} on the App Store` : `Open ${item.shortName}`}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        );
      })}
    </div>

    <div class="app-showcase__stage" data-scene-pin>
      <div class="app-showcase__frame">
        {/*
          Artwork layers stack in source order and each one fades up on its own
          beat, so the newest active layer simply covers the previous one. No
          fade-out pass is needed, which is what keeps this to pure CSS.
        */}
        <div class="app-showcase__art" aria-hidden="true">
          {apps.map((item, index) => (
            <span
              class:list={["app-showcase__art-layer", `app-showcase__art-layer--${item.theme}`]}
              style={`z-index:${index + 1};`}
              data-scene-item
              data-item-at={itemAt(index)}
              data-item-span={itemSpan}
            >
              <img
                src={item.iconHref}
                alt=""
                width="128"
                height="128"
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </span>
          ))}
        </div>

        <ol class="app-showcase__rail">
          {apps.map((item, index) => (
            <li
              class="app-showcase__tick"
              data-scene-item
              data-item-at={itemAt(index)}
              data-item-span={itemSpan}
            >
              <span class="app-showcase__tick-dot" aria-hidden="true"></span>
              <span class="app-showcase__tick-label">{item.shortName}</span>
            </li>
          ))}
        </ol>
      </div>

      {gridHref && (
        <a class="app-showcase__skip" href={gridHref} data-scroll-to>
          See the grid instead
        </a>
      )}
    </div>
  </div>
</section>
