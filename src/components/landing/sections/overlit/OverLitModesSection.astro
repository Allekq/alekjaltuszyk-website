---
import { arcadeModes, gridSizes } from "./overlit.data";
---

<section class="app-section overlit-modes" id="modes">
  <div class="app-shell">
    <header class="app-section__head app-section__head--centre">
      <p class="app-eyebrow">Arcade families</p>
      <h2 class="app-title">Many ways for the board to come at you.</h2>
      <p class="app-lead">
        Unlock arcade families as you progress. Each brings its own kind of pressure,
        with Survival and Time Attack rulesets.
      </p>
    </header>

    <ul class="overlit-modes__grid">
      {arcadeModes.map((mode) => (
        <li class="overlit-modes__card">
          <div class="overlit-modes__card-inner">
            <h3 class="overlit-modes__name">{mode.name}</h3>
            <p class="overlit-modes__description">{mode.description}</p>
            <ul class="overlit-modes__rulesets">
              {mode.rulesets.map((ruleset) => (
                <li>{ruleset}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ul>

    <aside class="overlit-modes__daily" aria-labelledby="daily-title">
      <h3 class="overlit-modes__name" id="daily-title">Daily challenges</h3>
      <p class="overlit-modes__description">
        Fresh challenges each day, generated on your device and playable offline.
        Replay for more stars, keep a daily streak, and earn themes by completing challenges
        on different days.
      </p>
    </aside>

    <div class="overlit-modes__footer">
      <p class="overlit-modes__footer-title">Board sizes</p>
      <ul class="overlit-modes__sizes">
        {gridSizes.map((size) => (
          <li class="app-chip">{size}</li>
        ))}
      </ul>
      <p class="overlit-modes__footer-note">
        Try a different grid size in arcade play for a different amount of pressure to read.
      </p>
    </div>
  </div>
</section>
