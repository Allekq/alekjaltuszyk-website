---
import { pressureSteps } from "./overlit.data";
---

<section class="app-section overlit-pressure" id="pressure">
  <div class="app-shell">
    <header class="app-section__head app-section__head--wide">
      <p class="app-eyebrow">How it plays</p>
      <h2 class="app-title">Read the colour. Beat the burnout.</h2>
      <p class="app-lead">Tap a lit cell before it burns out. The hotter it gets, the less time you have.</p>
    </header>

    <ol class="overlit-pressure__steps">
      {pressureSteps.map((step) => (
        <li class:list={["overlit-pressure__step", `is-${step.phase}`]}>
          <span class="overlit-pressure__swatch" aria-hidden="true"></span>
          <div>
            <h3 class="overlit-pressure__label">{step.label}</h3>
            <p class="overlit-pressure__body">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
