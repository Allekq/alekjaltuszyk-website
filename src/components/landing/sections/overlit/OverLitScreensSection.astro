---
import { withBase } from "../../../../lib/paths";

/* Captured from the shipped iPhone build. Every shot keeps the device's own
   status bar, so the phone frame around them must not draw a second notch. */
const screenshots = [
  {
    src: withBase("/media/overlit/iphone-classic-6x6-pressure.jpg"),
    alt: "OverLit Classic survival on a six by six grid, one cell critical red and two amber.",
    label: "Mid-run pressure",
    caption: "Classic on 6 × 6, seven seconds in: one cell already critical, two heating.",
    loading: "eager" as const,
  },
  {
    src: withBase("/media/overlit/iphone-levels-campaign.jpg"),
    alt: "OverLit level select screen showing the Novice levels and a locked Intermediate tier.",
    label: "Stars, not just clears",
    caption: "Three tiers per level, and the next tier stays shut until the stars arrive.",
    loading: "lazy" as const,
  },
  {
    src: withBase("/media/overlit/iphone-mode-hub.jpg"),
    alt: "OverLit mode hub listing Daily Challenge, Levels, Classic, and the locked Random, Pattern and Snake modes.",
    label: "Modes",
    caption: "The hub. Some of it is open on install, and the rest is something you earn.",
    loading: "lazy" as const,
  },
] as const;
---

<section class="app-section overlit-screens" id="screens">
  <div class="app-shell">
    <header class="app-section__head app-section__head--centre" data-rise>
      <p class="app-eyebrow">On the phone</p>
      <h2 class="app-title">Built to be readable with one thumb.</h2>
    </header>

    <ul class="overlit-screens__rail">
      {screenshots.map((shot, index) => (
        <li
          class="overlit-screens__slide"
          data-parallax
          data-parallax-speed={index === 1 ? 40 : -26}
          data-rise="scale"
        >
          <figure class="overlit-screens__figure">
            <div class="overlit-screens__phone tilt-surface" data-tilt data-tilt-strength="0.8">
              <img
                src={shot.src}
                alt={shot.alt}
                width="402"
                height="874"
                loading={shot.loading}
                decoding="async"
              />
              <span class="overlit-screens__glare" aria-hidden="true"></span>
            </div>
            <figcaption class="overlit-screens__caption">
              <span class="overlit-screens__label">{shot.label}</span>
              {shot.caption}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
