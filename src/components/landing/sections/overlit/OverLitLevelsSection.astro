---
import { levelTwists } from "./overlit.data";
---

<section class="app-section overlit-levels" id="levels">
  <div class="app-shell">
    <header class="app-section__head">
      <p class="app-eyebrow">The campaign</p>
      <h2 class="app-title">New levels. New pressure.</h2>
      <p class="app-lead">Learn the rhythm, then take on new patterns, tighter goals and boss milestones. Earn stars to open the next tier.</p>
    </header>

    <ul class="overlit-levels__list">
      {levelTwists.map((twist) => (
        <li class="overlit-levels__item">
          <h3 class="overlit-levels__item-name">{twist.name}</h3>
          <p class="overlit-levels__item-detail">{twist.detail}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
