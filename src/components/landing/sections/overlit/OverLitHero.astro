---
import ActionButton from "../../ui/ActionButton.astro";
import { heroBadges } from "./overlit.data";
import { overLitConfig } from "../../../../config/site";
---

<section class="overlit-hero" id="play">
  <div class="app-shell overlit-hero__grid">
    <div class="overlit-hero__copy">
      <div class="overlit-hero__identity">
        <p class="app-eyebrow">Reflex arcade · iPhone &amp; Android</p>
      </div>

      <h1 class="overlit-hero__title">
        Keep the grid alive.
      </h1>

      <p class="app-lead overlit-hero__lead">
        {overLitConfig.heroDescription}
      </p>

      <div class="app-actions">
        <ActionButton href={overLitConfig.getAppHref} label="Get the app" />
        <ActionButton href="#pressure" variant="ghost" label="How it plays" />
      </div>

      <ul class="app-chip-row overlit-hero__badges">
        {heroBadges.map((badge) => <li class="app-chip">{badge}</li>)}
      </ul>
    </div>

    <div class="overlit-hero__stage">
      {/*
        The HUD mirrors the app's real gameplay chrome — level, goal, score,
        time, board size — rather than inventing a scoring model. Failure is the
        app's: let a cell burn out and the run is over.
      */}
      <div
        class="overlit-board"
        data-board-demo
        data-board-size="5"
        data-board-state="static"
      >
        <div class="overlit-board__hud">
          <span class="overlit-board__hud-run">
            <strong class="overlit-board__hud-level">Demo</strong>
            <span class="overlit-board__hud-goal">Survive 0:25</span>
          </span>
          <span class="overlit-board__hud-metrics">
            <span class="overlit-board__hud-item">
              <span class="overlit-board__hud-label">Score</span>
              <strong data-board-score>0</strong>
            </span>
            <span class="overlit-board__hud-item">
              <span class="overlit-board__hud-label">Time</span>
              <strong data-board-clock>0.0</strong>
            </span>
          </span>
        </div>

        <div class="overlit-board__grid" data-board-grid role="group" aria-label="OverLit demo board">
          {Array.from({ length: 25 }, (_, index) => (
            <span class="overlit-board__cell" data-phase={index === 2 ? "critical" : index === 11 ? "warning" : index === 16 ? "lit" : "idle"} aria-hidden="true"></span>
          ))}
        </div>

        <div class="overlit-board__foot">
          <span class="overlit-board__size">5x5</span>
          <ul class="overlit-board__legend">
            <li data-phase="lit">Fresh</li>
            <li data-phase="warning">Warning</li>
            <li data-phase="critical">Critical</li>
          </ul>
        </div>

        <div class="overlit-board__overlay" data-board-overlay>
          <p class="overlit-board__result" data-board-result>Survive 25 seconds.</p>
          <p class="overlit-board__hint">
            Cells ignite, heat, then burn out. Tap them before they do — hotter cells are worth
            more, and one burnout ends the run.
          </p>
          <button class="overlit-board__start" type="button" data-board-start>Play the demo</button>
        </div>
      </div>

      <p class="overlit-hero__stage-note">
        A quick taste of the game. The app adds a campaign, daily challenges and arcade modes.
      </p>
      <noscript><p class="overlit-hero__stage-note">Enable JavaScript to play the demo, or get the app to play.</p></noscript>
    </div>
  </div>
</section>
