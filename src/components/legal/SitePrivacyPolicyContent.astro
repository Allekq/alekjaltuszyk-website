---
import { legalDocuments } from "../../../site.config.mjs";
import LegalDocumentHeader from "./LegalDocumentHeader.astro";
import SitePrivacyPolicyBody from "../../content/legal/site-privacy-policy.md";

const doc = legalDocuments.sitePrivacy;
---

<LegalDocumentHeader
  heading="Website Privacy Policy"
  documentName="Privacy Policy"
  version={doc.version}
  effectiveDate={doc.effectiveDate}
  sourcePath={doc.sourcePath}
  scope="site"
  kind="privacy"
/>

<SitePrivacyPolicyBody />
