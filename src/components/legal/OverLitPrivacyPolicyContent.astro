---
import { legalDocuments } from "../../../site.config.mjs";
import { overLitConfig } from "../../config/site";
import LegalDocumentHeader from "./LegalDocumentHeader.astro";
import OverLitPrivacyPolicyBody from "../../content/legal/overlit-privacy-policy.md";

const appName = overLitConfig.name;
const doc = legalDocuments.overLitPrivacy;
---

<LegalDocumentHeader
  heading={`${appName} Privacy Policy`}
  documentName="Privacy Policy"
  version={doc.version}
  effectiveDate={doc.effectiveDate}
  sourcePath={doc.sourcePath}
  appName={appName}
  kind="privacy"
/>

<OverLitPrivacyPolicyBody />
