---
import { legalDocuments } from "../../../site.config.mjs";
import { takeMeSomewhereConfig } from "../../config/site";
import LegalDocumentHeader from "./LegalDocumentHeader.astro";
import TakeMeSomewhereTermsBody from "../../content/legal/take-me-somewhere-terms-of-service.md";

const appName = takeMeSomewhereConfig.name;
const doc = legalDocuments.takeMeSomewhereTerms;
---

<LegalDocumentHeader
  heading={`${appName} Terms of Service`}
  documentName="Terms of Service"
  version={doc.version}
  effectiveDate={doc.effectiveDate}
  sourcePath={doc.sourcePath}
  appName={appName}
  kind="terms"
/>

<TakeMeSomewhereTermsBody />
