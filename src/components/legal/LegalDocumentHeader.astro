---
/**
 * Shared masthead for every published legal document.
 *
 * Bodies must identify actual release differences. A shared scope statement
 * cannot repair a false disclosure or grant optional-purpose consent.
 *
 * The revision history link points at the document body's file history in the
 * public website repo, which is the archive. Nothing needs to be copied or
 * snapshotted for it to work.
 */
import { legalSourceHistoryBase } from "../../../site.config.mjs";

interface Props {
  /** Rendered as the page heading, e.g. "OverLit Privacy Policy". */
  heading: string;
  /** How the document refers to itself in prose, e.g. "Privacy Policy". */
  documentName: string;
  version: string;
  effectiveDate: string;
  /**
   * Repo-relative path of the document body, used to build the revision
   * history link, e.g. "src/content/legal/overlit-privacy-policy.md".
   */
  sourcePath: string;
  /**
   * "app" documents get the cross-version scope sentence. "site" documents
   * cover a website, where there are no older installed versions to worry
   * about, so they get the supersession sentence only.
   */
  scope?: "app" | "site";
  /** Subject of the scope sentence, e.g. "OverLit". Required when scope is "app". */
  appName?: string;
  /** Privacy documents talk about information; terms talk about the agreement. */
  kind: "privacy" | "terms";
}

const {
  heading,
  documentName,
  version,
  effectiveDate,
  sourcePath,
  scope = "app",
  appName,
  kind,
} = Astro.props;

const historyHref = `${legalSourceHistoryBase}/${sourcePath}`;

const updateClause =
  kind === "privacy"
    ? "This notice describes information handling; acknowledging it does not grant consent for an optional purpose. Updates do not retroactively authorize processing or change how information was handled before their effective date."
    : "Changes apply prospectively, subject to any notice or agreement required by law. An updated document does not remove accrued rights or automatically replace the terms of an earlier purchase.";
---

<h1>{heading}</h1>

<p>
  <strong>Version:</strong> {version}<br />
  <strong>Last updated:</strong> {effectiveDate}
</p>

<p class="legal-scope">
  {
    scope === "app" && (
      <>
        This {documentName} covers {appName} across releases. Feature availability
        and information handling can differ by release; the relevant sections
        identify those differences. A planned feature described here applies
        only when it is available in your release. This scope does not remove
        obligations for older releases.{" "}
      </>
    )
  }
  {updateClause}
  Previous versions of this document remain publicly available in its{" "}
  <a href={historyHref} rel="noopener noreferrer" target="_blank">revision history</a>.
</p>
