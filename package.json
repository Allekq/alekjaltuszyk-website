{
  "name": "alekjaltuszyk-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/check-private-boundary.mjs && astro build && node scripts/check-private-boundary.mjs --include-dist",
    "preview": "astro preview",
    "check": "astro check",
    "check:private": "node scripts/check-private-boundary.mjs --include-dist",
    "test:private": "node --test scripts/check-private-boundary.test.mjs",
    "test:theme": "node --test scripts/theme.test.mjs",
    "test:workshop": "node --experimental-strip-types --test scripts/workshop-geometry.test.mjs",
    "check:contact": "node scripts/check-contact-emails.mjs",
    "check:legal": "node scripts/check-legal-consistency.mjs"
  },
  "dependencies": {
    "astro": "^6.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3"
  }
}
